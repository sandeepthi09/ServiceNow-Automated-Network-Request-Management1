        <name>Auto Populate Requester Information</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {

    if (isLoading) {
        return;
    }

    if (!newValue) {
        g_form.clearValue('email_id');
        g_form.clearValue('user_name');
        g_form.clearValue('phone_number');
        return;
    }

    var ga = new GlideAjax('NetworkRequesterInfo');
    ga.addParam('sysparm_name', 'getDetails');
    ga.addParam('sysparm_user', newValue);

    ga.getXMLAnswer(function(response) {

        if (!response) {
            return;
        }

        var result = JSON.parse(response);

        g_form.setValue('email_id', result.email || '');
        g_form.setValue('user_name', result.name || '');
        g_form.setValue('phone_number', result.phone || '');

    });
}]]></script>
